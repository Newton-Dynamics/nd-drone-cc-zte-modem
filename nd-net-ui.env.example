# nd-net-ui configuration — installed to /opt/nd-net/nd-net-ui.env
#
# The UI has NO authentication by design; it is protected solely by binding to
# the LAN/hotspot gateway addresses. Do NOT add 0.0.0.0 here — that would expose
# the SIM PIN / modem password and a service-restart button to any reachable
# network. List only addresses the Jetson owns on trusted segments.

# Space- or comma-separated IPs to bind. 10.42.0.1 = WiFi hotspot gateway,
# 10.42.1.1 = ethernet DHCP-server gateway, 127.0.0.1 = local (SSH port-forward).
ND_UI_BIND=10.42.0.1 10.42.1.1 127.0.0.1

# TCP port.
ND_UI_PORT=8088

# Paths to the two .env files the editor manages (defaults shown).
#ZTE_ENV_FILE=/opt/zte/.env
#ND_NET_ENV_FILE=/opt/nd-net/.env

# systemd unit the UI controls, and the status command it runs.
#ND_NET_SERVICE=nd-net-manager.service
#ND_UI_STATUS_CMD=nd-net-status
